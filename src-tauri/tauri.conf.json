{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "药品数据迁移助手",
  "version": "0.1.4",
  "identifier": "cn.bsoft.rbmh.medicine-migration",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npx vite build --outDir dist/desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "药品数据迁移助手",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
