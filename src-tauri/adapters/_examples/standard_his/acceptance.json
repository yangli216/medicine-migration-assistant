{
  "acceptanceSchemaVersion": 2,
  "adapterId": "STANDARD_HIS",
  "medicine": {
    "requiredObjects": ["HIS_DRUG"],
    "sourceIdentityFields": ["HIS_DRUG.DRUG_ID"],
    "scopes": ["ALL_MEDICINES"],
    "testCases": [
      "药品主表满足核心字段时可进入引导映射",
      "厂家商品表缺失时仍保留药品主档并使用 BASE 来源键"
    ]
  },
  "inventory": {
    "organizationObjects": ["HIS_ORGANIZATION"],
    "locationObjects": ["HIS_STORAGE"],
    "stockObjects": ["HIS_INVENTORY"],
    "stableKeys": [
      "sourceOrganizationId",
      "sourceLocationKey",
      "sourceRecordId",
      "sourceProductKey"
    ],
    "packagingEvidence": [
      "HIS_INVENTORY.SALE_UNIT/UNIT_SALE_FACTOR",
      "HIS_DRUG.MIN_PACKAGE_FACTOR"
    ],
    "amountEvidence": [
      "HIS_INVENTORY.QUANTITY",
      "HIS_INVENTORY.PURCHASE_PRICE/RETAIL_PRICE",
      "HIS_INVENTORY.PURCHASE_TOTAL/RETAIL_TOTAL"
    ],
    "testCases": [
      "机构与药库药房目录使用稳定主键并限制标准位置类型",
      "轻量范围只统计非零库存且不提前读取全部明细",
      "正式明细只读取本批选定机构和库房",
      "可选金额、批号和效期缺失时使用可核对的安全降级"
    ]
  },
